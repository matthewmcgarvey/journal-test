import gleam/dynamic/decode
import gleam/list
import gleam/result
import gleam/string
import pog

const migration_version = 1

const migration_statements = [
  "CREATE TABLE accounts (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    external_id TEXT NOT NULL CONSTRAINT accounts_external_id_key UNIQUE,
    track_balance BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
  )",
  "CREATE TABLE transfers (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    external_id TEXT NOT NULL CONSTRAINT transfers_external_id_key UNIQUE,
    debit_account_id BIGINT NOT NULL REFERENCES accounts(id),
    credit_account_id BIGINT NOT NULL REFERENCES accounts(id),
    amount BIGINT NOT NULL CONSTRAINT transfers_amount_positive CHECK (amount > 0),
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT transfers_distinct_accounts CHECK (debit_account_id <> credit_account_id)
  )",
  "CREATE TABLE entries (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    account_id BIGINT NOT NULL REFERENCES accounts(id),
    transfer_id BIGINT NOT NULL REFERENCES transfers(id),
    amount BIGINT NOT NULL CONSTRAINT entries_amount_positive CHECK (amount > 0),
    debit BOOLEAN NOT NULL,
    CONSTRAINT entries_transfer_account_key UNIQUE (transfer_id, account_id)
  )",
  "CREATE TABLE account_balances (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    account_id BIGINT NOT NULL REFERENCES accounts(id),
    running_balance BIGINT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
  )",
  "CREATE INDEX account_balances_account_id_id_idx
    ON account_balances (account_id, id DESC)",
  "CREATE FUNCTION reject_immutable_change() RETURNS TRIGGER
    LANGUAGE plpgsql
    AS $$ BEGIN
      RAISE EXCEPTION 'immutable records cannot be changed'
        USING ERRCODE = '55000';
    END; $$",
  "CREATE TRIGGER accounts_immutable
    BEFORE UPDATE OR DELETE ON accounts
    FOR EACH ROW EXECUTE FUNCTION reject_immutable_change()",
  "CREATE TRIGGER transfers_immutable
    BEFORE UPDATE OR DELETE ON transfers
    FOR EACH ROW EXECUTE FUNCTION reject_immutable_change()",
  "CREATE TRIGGER entries_immutable
    BEFORE UPDATE OR DELETE ON entries
    FOR EACH ROW EXECUTE FUNCTION reject_immutable_change()",
  "CREATE TRIGGER account_balances_immutable
    BEFORE UPDATE OR DELETE ON account_balances
    FOR EACH ROW EXECUTE FUNCTION reject_immutable_change()",
]

pub fn migrate(connection: pog.Connection) -> Result(Nil, String) {
  case
    execute(
      connection,
      "CREATE TABLE IF NOT EXISTS schema_migrations (
      version INTEGER PRIMARY KEY,
      applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
    )",
    )
  {
    Error(error) -> Error(string.inspect(error))
    Ok(_) -> {
      case
        query(
          connection,
          "SELECT version FROM schema_migrations WHERE version = $1",
          [pog.int(migration_version)],
          int_row_decoder(),
        )
      {
        Error(error) -> Error(string.inspect(error))
        Ok(pog.Returned(_, [_])) -> Ok(Nil)
        Ok(pog.Returned(_, [])) -> apply_migration(connection)
        Ok(_) -> Error("Unexpected migration query result")
      }
    }
  }
}

fn apply_migration(connection: pog.Connection) -> Result(Nil, String) {
  case
    pog.transaction(connection, fn(transaction) {
      use _ <- result.try(run_statements(transaction, migration_statements))
      query(
        transaction,
        "INSERT INTO schema_migrations (version) VALUES ($1)",
        [pog.int(migration_version)],
        decode.success(Nil),
      )
      |> result.map_error(string.inspect)
    })
  {
    Ok(_) -> Ok(Nil)
    Error(pog.TransactionRolledBack(error)) -> Error(error)
    Error(pog.TransactionQueryError(error)) -> Error(string.inspect(error))
  }
}

fn run_statements(
  connection: pog.Connection,
  statements: List(String),
) -> Result(Nil, String) {
  case statements {
    [] -> Ok(Nil)
    [statement, ..remaining] ->
      case execute(connection, statement) {
        Error(error) -> Error(string.inspect(error))
        Ok(_) -> run_statements(connection, remaining)
      }
  }
}

fn execute(
  connection: pog.Connection,
  sql: String,
) -> Result(pog.Returned(Nil), pog.QueryError) {
  pog.query(sql)
  |> pog.execute(on: connection)
}

fn query(
  connection: pog.Connection,
  sql: String,
  parameters: List(pog.Value),
  decoder: decode.Decoder(a),
) -> Result(pog.Returned(a), pog.QueryError) {
  let query =
    list.fold(parameters, pog.query(sql), fn(query, parameter) {
      pog.parameter(query, parameter)
    })
    |> pog.returning(decoder)
  pog.execute(query, on: connection)
}

fn int_row_decoder() -> decode.Decoder(Int) {
  use value <- decode.field(0, decode.int)
  decode.success(value)
}
